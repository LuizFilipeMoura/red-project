// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Lobby {
  id           String   @id
  name         String
  isPrivate    Boolean  @default(false) @map("is_private")
  passwordHash String?  @map("password_hash")
  capacity     Int
  ownerSid     String?  @map("owner_sid")
  createdAt    DateTime @default(now()) @map("created_at")
  status       String   @default("waiting")

  players Player[]
  match   Match?  @relation("LobbyMatch")

  @@map("lobbies")
}

model Player {
  id       Int      @id @default(autoincrement())
  lobbyId  String   @map("lobby_id")
  sid      String
  joinedAt DateTime @default(now()) @map("joined_at")
  isReady  Boolean  @default(false) @map("is_ready")

  lobby Lobby @relation(fields: [lobbyId], references: [id], onDelete: Cascade)

  @@map("players")
}

model Match {
  id               String   @id
  currentPlayerSid String   @map("current_player_sid")
  turnNumber       Int      @map("turn_number")
  stateJson        String   @map("state_json")
  updatedAt        DateTime @default(now()) @map("updated_at")

  lobby   Lobby   @relation("LobbyMatch", fields: [id], references: [id], onDelete: Cascade)
  units   Unit[]
  actions ActionLog[]

  @@map("matches")
}

model Unit {
  id            String @id
  matchId       String @map("match_id")
  type          String
  ownerSid      String @map("owner_sid")
  x             Int
  y             Int
  canMoveAtTurn Int    @map("can_move_at_turn")

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@map("units")
}

model ActionLog {
  id          Int      @id @default(autoincrement())
  matchId     String   @map("match_id")
  type        String
  payloadJson String   @map("payload_json")
  ts          DateTime @default(now())

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@map("actions_log")
}
